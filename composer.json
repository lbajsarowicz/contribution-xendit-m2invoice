{
  "name": "xendit/m2invoice",
  "description": "Xendit Payment Gateway Module",
  "type": "magento2-module",
  "version": "14.1.0",
  "license": [
    "GPL-3.0"
  ],
  "require": {
    "php": "~7.1.3||~7.2.0||~7.3.0||~7.4.0||~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "magento/module-sales": ">=102.0.3",
    "magento/module-checkout": ">=100.3.3",
    "magento/module-payment": ">=100.3.3",
    "magento/framework": ">=102.0.3"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Xendit\\M2Invoice\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
